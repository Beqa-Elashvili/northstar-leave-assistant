# Copy this file to .env and fill in the values. Never commit .env.

# --- Business date ------------------------------------------------------------
# All leave-rule date calculations use this date instead of the machine clock.
# The supplied data reflects the state on 2026-10-19.
APP_TODAY=2026-10-19
APP_TIMEZONE=Asia/Tbilisi

# --- Supabase PostgreSQL (backend only) --------------------------------------
# Supabase dashboard -> Connect -> "Session pooler" connection string (IPv4 compatible).
# Example shape: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
# Postgres schema for the application tables (default: public).
DB_SCHEMA=public

# Supabase project URL and service-role key. Backend-only: used by `scripts/check_setup.py`
# to verify the project; never sent to the CLI user or printed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM / embeddings (Google Gemini) -----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# gemini (default) or local (offline character n-gram hashing; lower retrieval quality,
# no API key needed — used by the automated tests).
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(...) size in migrations (768).
EMBEDDING_DIM=768
# Embedded texts per minute (Gemini free tier allows 100; raise it on a paid tier).
EMBEDDING_RPM=90

# --- Local-development identity -----------------------------------------------
# NOT production authentication: the MCP server treats this employee as the
# authenticated user of the employee assistant.
DEMO_EMPLOYEE_ID=E1001

# --- Tests (optional) ----------------------------------------------------------
# A PostgreSQL URL for the automated tests. Tests create and drop their own
# temporary schema, so the application data is never touched. When empty, the
# test suite starts an embedded PostgreSQL (pgserver) instead.
TEST_DATABASE_URL=
